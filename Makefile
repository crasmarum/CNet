# Makefile with Automatic Compiler Detection (nvcc/g++)
#
# This Makefile checks for the presence of the NVIDIA CUDA Compiler (nvcc).
# - If nvcc is found, it compiles the project with CUDA support.
# - If nvcc is not found, it falls back to using g++.

# --- Configuration ---

# Target executable name and location.
TARGET_DIR = $(HOME)
TARGET_NAME = cnet
TARGET = $(TARGET_DIR)/$(TARGET_NAME)

# Directory for build artifacts (object files).
BUILD_DIR = build
OBJ_DIR = $(BUILD_DIR)/obj

# --- Compiler Auto-Detection ---

# Check if the 'nvcc' command exists in the system's PATH.
NVCC_RESULT := $(shell which nvcc 2>/dev/null)
NVCC_TEST := $(notdir $(NVCC_RESULT))

# --- Conditional Build Configuration ---

ifeq ($(NVCC_TEST),nvcc)
    # --- NVCC Configuration (CUDA Build) ---
    INFO_MSG = "==> NVCC detected. Building with CUDA support."
    CXX = nvcc
    # Flags for nvcc:
    # -x cu: Treat all source files as CUDA files.
    # -Xcompiler -fopenmp: Pass the -fopenmp flag to the host compiler (like g++).
    # -MMD -MP: emit a .d file per object listing the headers it includes, so
    # header edits trigger the right recompiles (-MP adds phony header targets
    # so a removed header doesn't break the build).
    # Native code for Ampere (A100, sm_80) and Hopper (H100/H200/GH200, sm_90), plus compute_90 PTX
    # that newer GPUs JIT-compile. Without -gencode nvcc emits only sm_52 (Maxwell) code, which the
    # driver JIT-compiles at startup and which cannot use any post-Maxwell instruction. Override with
    # e.g. `make GPU_ARCH="-gencode arch=compute_100,code=sm_100"` for Blackwell.
    GPU_ARCH ?= -gencode arch=compute_80,code=sm_80 -gencode arch=compute_90,code=sm_90 -gencode arch=compute_90,code=compute_90
    CXXFLAGS = -x cu -std=c++11 -Xcompiler -fopenmp -O2 -MMD -MP --default-stream per-thread $(GPU_ARCH)
    LDFLAGS = -lgomp -lcufft -lcublas # OpenMP + cuFFT + cuBLAS (TokenwiseLinear GEMMs).
    # NCCL is only needed by code that does multi-GPU all-reduce. The dp_shakespeare
    # example links it directly; MAINLIBS adds it to the dev main (gpu_tests.h uses
    # it) and is patched empty for the public main by github_export.sh.
    MAINLIBS =
    SRCS = utils/flags.cpp \
           gpu/gpu_func.cpp \
           impl/vars.cpp \
           gpu/kernels.cpp \
           gpu/reduce.cpp \
           gpu/reducegrad.cpp \
           gpu/gla_gpu.cpp \
           gpu/chirp_gpu.cpp \
           cnet.cpp

else
    # --- G++ Configuration (Standard Build) ---
    INFO_MSG = "==> NVCC not found. Building with g++."
    CXX = g++
    # Note: -Xclang is specific to the Clang frontend. -fopenmp is the standard g++ flag.
    CXXFLAGS = -std=c++11 -Xclang -fopenmp -O2 -MMD -MP
    LDFLAGS = -lomp # Link with the OpenMP library.
    SRCS = utils/flags.cpp \
           impl/vars.cpp \
           gpu/gpu_func.cpp \
           gpu/reduce.cpp \
           gpu/reducegrad.cpp \
           gpu/gla_gpu.cpp \
           gpu/chirp_gpu.cpp \
           gpu/kernels.cpp \
           cnet.cpp
endif

# --- Automatic Variable Generation ---

# VPATH tells 'make' where to look for source files.
# This is created automatically from the unique directory paths in the SRCS variable.
VPATH = $(sort $(dir $(SRCS))) examples

# Generate object file names, placing them in the OBJ_DIR.
# This handles both .cpp and .cu files correctly.
# e.g., gpu/reduce.cpp becomes build/obj/reduce.o
# e.g., gpu/gpu_func.cu becomes build/obj/gpu_func.o
OBJS = $(addprefix $(OBJ_DIR)/, $(notdir $(SRCS:.cpp=.o)))
OBJS := $(subst .cu,.o,$(OBJS))

# Per-object dependency files (generated by -MMD); pulled in at the bottom so
# each .o is rebuilt when any header it includes changes.
DEPS = $(OBJS:.o=.d)


# Framework objects (everything except the selected main), reused by example mains.
FW_SRCS = utils/flags.cpp gpu/gpu_func.cpp impl/vars.cpp gpu/kernels.cpp gpu/reduce.cpp gpu/reducegrad.cpp gpu/gla_gpu.cpp gpu/chirp_gpu.cpp
FW_OBJS = $(addprefix $(OBJ_DIR)/, $(notdir $(FW_SRCS:.cpp=.o)))


# --- Build Rules ---

# Phony targets are not actual files. 'all' is the default goal.
.PHONY: all clean run info app dp_shakespeare generate gollm radioml mnist_hadamard bench_mixer bench_clone bench_bornattn test_conjlag_fd test_hadamardconv_fd test_hadamardconv_gpu test_bornattn_mh test_gla test_chirp_fd test_chirp_gpu chime_detect
.DEFAULT_GOAL := all

# Standalone multi-GPU data-parallel tiny-shakespeare example (its own main).
dp_shakespeare: $(FW_OBJS) $(OBJ_DIR)/dp_shakespeare.o
	@mkdir -p $(TARGET_DIR)
	$(CXX) $^ $(LDFLAGS) -lnccl -o $(TARGET_DIR)/dp_shakespeare
	@echo "==> Built $(TARGET_DIR)/dp_shakespeare"

# Go move-prediction LM (examples/gollm.cpp). NCCL is optional: `make gollm`
# builds the multi-GPU version (needs NCCL); `make gollm NCCL=0` builds a
# single-GPU version with no NCCL (forces -world 1) for boxes without it.
NCCL ?= 1
GOLLM_DEF := $(if $(filter 0,$(NCCL)),,-DWITH_NCCL)
GOLLM_LIB := $(if $(filter 0,$(NCCL)),,-lnccl)
gollm: $(FW_OBJS)
	@mkdir -p $(TARGET_DIR) $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(GOLLM_DEF) -c examples/gollm.cpp -o $(OBJ_DIR)/gollm.o
	$(CXX) $(FW_OBJS) $(OBJ_DIR)/gollm.o $(LDFLAGS) -lcurand $(GOLLM_LIB) -o $(TARGET_DIR)/gollm
	@echo "==> Built $(TARGET_DIR)/gollm (NCCL=$(if $(filter 0,$(NCCL)),off,on))"

# Any program written on impl/cnet_app.h (app::Trainer / app::Infer):
#   make app SRC=examples/char_lm.cpp            # multi-GPU build (needs NCCL); binary named after the source
#   make app SRC=my/model.cpp NCCL=0             # single-GPU build, no NCCL
APP_NAME = $(basename $(notdir $(SRC)))
app: $(FW_OBJS)
	@test -n "$(SRC)" || (echo "usage: make app SRC=path/to/program.cpp [NCCL=0]" && false)
	@mkdir -p $(TARGET_DIR) $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) $(GOLLM_DEF) -c $(SRC) -o $(OBJ_DIR)/app_$(APP_NAME).o
	$(CXX) $(FW_OBJS) $(OBJ_DIR)/app_$(APP_NAME).o $(LDFLAGS) $(GOLLM_LIB) -o $(TARGET_DIR)/$(APP_NAME)
	@echo "==> Built $(TARGET_DIR)/$(APP_NAME) (NCCL=$(if $(filter 0,$(NCCL)),off,on))"

# Radio modulation classifier (examples/radioml.cpp). Single-GPU, no NCCL;
# links the framework objects + cuFFT/cuBLAS (via LDFLAGS). Run: ./radioml ...
radioml: $(FW_OBJS)
	@mkdir -p $(TARGET_DIR) $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c examples/radioml.cpp -o $(OBJ_DIR)/radioml.o
	$(CXX) $(FW_OBJS) $(OBJ_DIR)/radioml.o $(LDFLAGS) -o $(TARGET_DIR)/radioml
	@echo "==> Built $(TARGET_DIR)/radioml"

# Dispersed-burst detection in raw CHIME voltages with ChirpFilter + BoxcarMax (examples/chime_detect.cpp). No NCCL.
chime_detect: $(FW_OBJS)
	@mkdir -p $(TARGET_DIR) $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c examples/chime_detect.cpp -o $(OBJ_DIR)/chime_detect.o
	$(CXX) $(FW_OBJS) $(OBJ_DIR)/chime_detect.o $(LDFLAGS) -o $(TARGET_DIR)/chime_detect
	@echo "==> Built $(TARGET_DIR)/chime_detect"

# Graph-cloning systems benchmark (examples/bench_clone.cpp). Single-GPU, no NCCL.
bench_clone: $(FW_OBJS)
	@mkdir -p $(TARGET_DIR) $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c examples/bench_clone.cpp -o $(OBJ_DIR)/bench_clone.o
	$(CXX) $(FW_OBJS) $(OBJ_DIR)/bench_clone.o $(LDFLAGS) -o $(TARGET_DIR)/bench_clone
	@echo "==> Built $(TARGET_DIR)/bench_clone"

# Causal-mixer latency benchmark (examples/bench_mixer.cpp). Single-GPU, no NCCL.
bench_mixer: $(FW_OBJS)
	@mkdir -p $(TARGET_DIR) $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c examples/bench_mixer.cpp -o $(OBJ_DIR)/bench_mixer.o
	$(CXX) $(FW_OBJS) $(OBJ_DIR)/bench_mixer.o $(LDFLAGS) -o $(TARGET_DIR)/bench_mixer
	@echo "==> Built $(TARGET_DIR)/bench_mixer"

# Born-attention micro-benchmark (examples/bench_bornattn.cpp). Single-GPU, no NCCL.
bench_bornattn: $(FW_OBJS)
	@mkdir -p $(TARGET_DIR) $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c examples/bench_bornattn.cpp -o $(OBJ_DIR)/bench_bornattn.o
	$(CXX) $(FW_OBJS) $(OBJ_DIR)/bench_bornattn.o $(LDFLAGS) -o $(TARGET_DIR)/bench_bornattn
	@echo "==> Built $(TARGET_DIR)/bench_bornattn"

# Shallow Hadamard-conv MNIST trainer (examples/mnist_hadamard.cpp). Single-GPU, no NCCL.
mnist_hadamard: $(FW_OBJS)
	@mkdir -p $(TARGET_DIR) $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c examples/mnist_hadamard.cpp -o $(OBJ_DIR)/mnist_hadamard.o
	$(CXX) $(FW_OBJS) $(OBJ_DIR)/mnist_hadamard.o $(LDFLAGS) -o $(TARGET_DIR)/mnist_hadamard
	@echo "==> Built $(TARGET_DIR)/mnist_hadamard"

# Standalone CPU-only text generator (its own main; no CUDA/NCCL).
generate: $(FW_OBJS) $(OBJ_DIR)/generate.o
	@mkdir -p $(TARGET_DIR)
	$(CXX) $^ $(LDFLAGS) -o $(TARGET_DIR)/generate
	@echo "==> Built $(TARGET_DIR)/generate"

# Standalone CPU finite-difference gradient check for ConjLagProduct (no NCCL;
# links the framework objects only). Run: ./test_conjlag_fd
test_conjlag_fd: $(FW_OBJS)
	@mkdir -p $(TARGET_DIR) $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c examples/test_conjlag_fd.cpp -o $(OBJ_DIR)/test_conjlag_fd.o
	$(CXX) $(FW_OBJS) $(OBJ_DIR)/test_conjlag_fd.o $(LDFLAGS) -o $(TARGET_DIR)/test_conjlag_fd
	@echo "==> Built $(TARGET_DIR)/test_conjlag_fd"

# Standalone CPU checks for ChirpFilter and BoxcarMax (forward, finite differences, save/restore; no NCCL).
test_chirp_fd: $(FW_OBJS)
	@mkdir -p $(TARGET_DIR) $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c examples/test_chirp_fd.cpp -o $(OBJ_DIR)/test_chirp_fd.o
	$(CXX) $(FW_OBJS) $(OBJ_DIR)/test_chirp_fd.o $(LDFLAGS) -o $(TARGET_DIR)/test_chirp_fd
	@echo "==> Built $(TARGET_DIR)/test_chirp_fd"

# GPU-vs-CPU parity for ChirpFilter and BoxcarMax (needs a GPU; no NCCL).
test_chirp_gpu: $(FW_OBJS)
	@mkdir -p $(TARGET_DIR) $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c examples/test_chirp_gpu.cpp -o $(OBJ_DIR)/test_chirp_gpu.o
	$(CXX) $(FW_OBJS) $(OBJ_DIR)/test_chirp_gpu.o $(LDFLAGS) -o $(TARGET_DIR)/test_chirp_gpu
	@echo "==> Built $(TARGET_DIR)/test_chirp_gpu"

# Standalone CPU finite-difference gradient check for HadamardConv (no NCCL).
test_hadamardconv_fd: $(FW_OBJS)
	@mkdir -p $(TARGET_DIR) $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c examples/test_hadamardconv_fd.cpp -o $(OBJ_DIR)/test_hadamardconv_fd.o
	$(CXX) $(FW_OBJS) $(OBJ_DIR)/test_hadamardconv_fd.o $(LDFLAGS) -o $(TARGET_DIR)/test_hadamardconv_fd
	@echo "==> Built $(TARGET_DIR)/test_hadamardconv_fd"

# Standalone GPU-vs-CPU parity check for HadamardConv (needs a GPU; no NCCL).
test_hadamardconv_gpu: $(FW_OBJS)
	@mkdir -p $(TARGET_DIR) $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c examples/test_hadamardconv_gpu.cpp -o $(OBJ_DIR)/test_hadamardconv_gpu.o
	$(CXX) $(FW_OBJS) $(OBJ_DIR)/test_hadamardconv_gpu.o $(LDFLAGS) -o $(TARGET_DIR)/test_hadamardconv_gpu
	@echo "==> Built $(TARGET_DIR)/test_hadamardconv_gpu"

# Multi-head BornAttention / per-head RoPE checks (FD, head-slicing oracle, GPU parity,
# serialization). No NCCL; -gpu 0 skips the GPU parity part.
test_bornattn_mh: $(FW_OBJS)
	@mkdir -p $(TARGET_DIR) $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c examples/test_bornattn_mh.cpp -o $(OBJ_DIR)/test_bornattn_mh.o
	$(CXX) $(FW_OBJS) $(OBJ_DIR)/test_bornattn_mh.o $(LDFLAGS) -o $(TARGET_DIR)/test_bornattn_mh
	@echo "==> Built $(TARGET_DIR)/test_bornattn_mh"

test_gla: $(FW_OBJS)
	@mkdir -p $(TARGET_DIR) $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c examples/test_gla.cpp -o $(OBJ_DIR)/test_gla.o
	$(CXX) $(FW_OBJS) $(OBJ_DIR)/test_gla.o $(LDFLAGS) -o $(TARGET_DIR)/test_gla
	@echo "==> Built $(TARGET_DIR)/test_gla"

# Default target: build the final executable.
all: $(TARGET)

# Rule to link the final executable from all the object files.
$(TARGET): $(OBJS)
	@echo "==> Linking target: $@"
	@mkdir -p $(TARGET_DIR) # Ensure the target directory exists.
	$(CXX) $^ $(LDFLAGS) $(MAINLIBS) -o $@
	@echo "==> Build complete. Executable is at $(TARGET)"

# Generic pattern rule to compile any source file (.cpp or .cu) into an object file.
# This works because both nvcc (with -x cu) and g++ can handle .cpp files.
# The VPATH variable allows 'make' to find the source file in its original directory.
$(OBJ_DIR)/%.o: %.cpp
	@echo "==> Compiling $<..."
	@mkdir -p $(OBJ_DIR) # Ensure the object directory exists.
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(OBJ_DIR)/%.o: %.cu
	@echo "==> Compiling $<..."
	@mkdir -p $(OBJ_DIR) # Ensure the object directory exists.
	$(CXX) $(CXXFLAGS) -c $< -o $@


# --- Utility Rules ---

# Rule to display which compiler is being used.
info:
	@echo $(INFO_MSG)

# Rule to run the compiled application.
run: all
	@echo "==> Running application..."
	@$(TARGET)
	@echo "==> Application finished."

# Rule to clean up all generated files.
clean:
	@echo "==> Cleaning up build artifacts..."
	@rm -rf $(BUILD_DIR) $(TARGET)
	@echo "==> Cleanup complete."

# Pull in the generated header dependencies (silently absent on a fresh build).
# Every object's .d file (the framework sources AND the example / test programs, which DEPS above
# does not list): without them an example object is not rebuilt when a header it includes changes,
# and a class layout change then corrupts memory at run time.
-include $(DEPS) $(wildcard $(OBJ_DIR)/*.d)


